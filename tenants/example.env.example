# One file per tenant. Copy to tenants/<name>.env and fill in.
# Run it with: make onboard TENANT=<name>

TENANT_ID=
AZURE_CLOUD=                 # AzureCloud or AzureUSGovernment; overrides .env
BILLING_MODEL=               # MCA or CSP; overrides .env

# Storage for this tenant's FOCUS exports. Created if missing. The storage
# account name must be globally unique, 3-24 chars, lowercase letters and digits.
RESOURCE_GROUP=
STORAGE_ACCOUNT=
CONTAINER=
LOCATION=

# Which subscription the resource group, storage account and container go in.
# Leave empty and the Azure CLI's ACTIVE subscription is used -- after
# `az login --tenant <id>` that is whichever subscription Azure happened to
# return first, which is nobody's choice and is not stable across the tenants
# in an onboard-all run. Set it to pin the placement. A run that leaves it
# empty prints which subscription it ended up using.
#
# This is NOT the same thing as SUBSCRIPTIONS below: this is where the
# resources live, that is whose costs get exported. They are independent -- a
# tenant can export at billingAccount scope (covering every subscription) while
# its storage sits in one specific subscription.
#
# Must be a bare GUID belonging to THIS tenant; onboard-tenant.sh refuses
# anything else. `az account list` returns every tenant's subscriptions that
# the CLI profile has seen, so an id pasted from the wrong row is usually still
# a real subscription -- just somebody else's. `make preflight` lists this
# tenant's subscriptions in its SUBS column.
#
# Changing this after the tenant is onboarded creates a SECOND storage account
# rather than moving the first, and Kion cannot edit an existing Azure billing
# source through its API. Set it before the first run.
RESOURCE_SUBSCRIPTION_ID=

# How much of the pipeline this tenant gets.
#
#   full        storage -> exports -> app -> Kion billing source (the default)
#   management  the app registration only: no storage, no export, nothing
#               posted to Kion, KION_PAYER_ID never written
#
# Use management for a tenant whose spend arrives through ANOTHER tenant's
# export. Under a shared MCA billing account that is every customer tenant:
# the only scope carrying data is the billing account, it lives in the roll-up
# tenant, and it already covers every tenant at once. Storage keys left set
# below are reported as ignored rather than quietly skipped.
ONBOARD_MODE=

# Also grant the "Minimal subscription move" custom role (roleAssignments
# write/delete + subscriptions/write at the management group), so Kion can
# create subscriptions and resource groups. Empty means no. Accepts 1, true or
# yes; anything else is an error rather than a silent no, because a setting
# that exists only to grant something must never fail quiet.
ENABLE_SUBSCRIPTION_CREATION=

# billingAccount (the shared .env default) creates a single export covering
# every subscription in the tenant, which Kion needs: it keeps only the single
# newest manifest under a billing source's prefix, so more than one export
# under the same prefix means Kion silently ingests just one of them and every
# other subscription's costs vanish with no error. billingProfile works the
# same way, one export per profile, and also needs BILLING_SCOPE_ID below.
#
# subscription scope is REFUSED when BILLING_MODEL=MCA. Verified 2026-09-15
# against a real MCA billing account with "View charges" enabled: the export
# is created, schedules and runs, and writes no rows and no manifest at all.
# Nothing this tool checks can see that, so Kion would be pointed at a prefix
# that never gains a manifest and the tenant would show no spend, with no
# error anywhere. Use billingAccount/billingProfile, or ONBOARD_MODE=management
# if this tenant is billed through another tenant's export.
#
# Under CSP, subscription scope is the only scope a customer tenant has, and
# it is only correct for a tenant with EXACTLY ONE subscription. If it
# resolves to more than one, create-focus-exports.sh fails loudly before
# creating anything rather than silently dropping cost data. Management group
# scope is not supported by Azure for FOCUS exports.
EXPORT_SCOPE=
BILLING_SCOPE_ID=
# Whose COSTS get exported, not where the storage goes -- see
# RESOURCE_SUBSCRIPTION_ID above for that.
SUBSCRIPTIONS=               # optional allowlist, space separated; empty means all; only used by subscription scope

# Only set this if this tenant needs a different Cost Management Exports
# api-version than the shared .env default (or create-focus-exports.sh's own
# default, if .env doesn't set one either) — e.g. to pin back to an older
# version for a tenant where the newer one misbehaves.
EXPORT_API_VERSION=

# The export's dataset version and schedule. Each falls back to the shared
# .env value when left empty here, so only set one if this tenant needs to
# differ. Uncomment to override.
#FOCUS_VERSION=1.0
#EXPORT_RECURRENCE=Daily          # schedule.recurrence: Daily / Weekly / Monthly / Annually
#EXPORT_TIMEFRAME=MonthToDate     # definition.timeframe, a separate field from the recurrence

# Where in the container Azure writes. Falls back to the shared .env value.
# This is the rootFolderPath only: Azure inserts the export name as a folder
# below it, so the prefix the Kion billing source is given is
# "<EXPORT_PREFIX>/<scope-leaf>/<export-name>", computed for you.
#EXPORT_PREFIX=focus

MANAGEMENT_GROUP=            # Owner is granted here; empty means the tenant root group

# Written back automatically once the billing source is created. Leave empty.
KION_PAYER_ID=
