# Shared defaults for every tenant. Copy to .env and fill in.
#
# WARNING: the Makefile loads this file with `-include .env`, so `make`
# itself parses these values, not just bash: a `#` starts a make comment
# (truncating anything after it, even inside a value) and a bare `$` begins a
# make variable expansion. If a secret below (e.g. KION_API_KEY) legitimately
# contains either character, avoid `#` entirely and write a literal `$` as
# `$$`, or the value will be silently truncated or mangled and the failure
# will only surface later as an authentication error against Kion.

# Kion connection. One Kion serves every tenant.
KION_HOST=
KION_API_KEY=
KION_API_BASE=/api

# Defaults, overridable per tenant. Gov and Commercial tenants are expected to
# be onboarded from the same checkout, so both of these are per-tenant settings
# with a default here. AzureUSGovernment because that's the cloud the tenants
# this tool onboards actually live in; override AZURE_CLOUD per tenant for a
# Commercial one.
AZURE_CLOUD=AzureUSGovernment
BILLING_MODEL=MCA

# FOCUS export settings. FocusCost only: the FOCUS dataset already carries both
# actual (BilledCost) and amortized (EffectiveCost) costs, and Kion cannot read
# the ActualCost/AmortizedCost dataset types.
FOCUS_VERSION=1.0
EXPORT_RECURRENCE=Daily
EXPORT_TIMEFRAME=MonthToDate
EXPORT_PREFIX=focus

# api-version for the Cost Management Exports REST call. Azure moves this
# version over time, and 2023-08-01 and earlier cannot create FOCUS exports at
# all (their ExportType enum has no FocusCost) — only override this if a newer
# default in create-focus-exports.sh ever needs to be pinned back down.
EXPORT_API_VERSION=2025-03-01
