#!/bin/bash
# Recording stub for az. Logs every invocation to $AZ_LOG and answers from
# $AZ_STATE (key=value lines). Set AZ_FAIL_MATCH to a regex to force failure.
echo "$*" >> "$AZ_LOG"
state() { sed -n "s/^$1=//p" "$AZ_STATE" 2>/dev/null | tail -1; }
if [ -n "${AZ_FAIL_MATCH:-}" ] && printf '%s' "$*" | grep -qE "$AZ_FAIL_MATCH"; then
  echo "stub az: forced failure" >&2; exit 1
fi
case "$*" in
  "account show --query tenantId"*)  echo "$(state TENANT_ID)" ;;
  "account show --query id"*)        echo "$(state SUBSCRIPTION_ID)" ;;
  # The CLI's active cloud, which onboard-tenant.sh compares against the
  # configured AZURE_CLOUD. Deliberately answered from state with no default:
  # a test that forgets to declare which cloud the CLI is on must not be
  # silently handed the one that happens to make its fixture pass.
  "account show --query environmentName"*) echo "$(state ENVIRONMENT_NAME)" ;;
  # The session's own identity, used by preflight-tenants.sh to ask what role
  # it holds. Two keys, not one: "no signed-in user" (a service principal) and
  # "cannot identify the session at all" are different answers there.
  "account show --query user.name"*) echo "$(state USER_NAME)" ;;
  "ad signed-in-user show"*)         echo "$(state SIGNED_IN_OID)" ;;
  # Role names come back one per line from the real CLI; declare them
  # comma-separated in state and split here, as with SUBSCRIPTIONS.
  "role assignment list"*)           echo "$(state MG_ROLES)" | tr ',' '\n' ;;
  "billing account list"*)           echo "$(state BILLING_ACCOUNTS)" | tr ',' '\n' ;;
  # Per-account subscription -> billing profile map, as TSV rows. State key
  # BILLING_SUBS_<account> holds "sub|profile" pairs separated by commas, so a
  # test can model one account whose subscriptions span two profiles.
  "billing subscription list"*)
    _q_acct="$(printf '%s' "$*" | sed -n 's/.*--account-name \([^ ]*\).*/\1/p')"
    if [ -n "$_q_acct" ]; then
      state "BILLING_SUBS_${_q_acct}" | tr ',' '\n' \
        | while IFS= read -r _pair; do
            [ -n "$_pair" ] || continue
            printf '%s\t%s\n' "${_pair%%|*}" "${_pair#*|}"
          done
    fi
    ;;
  # `account list` honours a --query filter of the form [?tenantId=='<id>'],
  # answering from state key SUBSCRIPTIONS_<id> when the test defines one. That
  # is what lets a test model a CLI profile holding two tenants' subscriptions
  # (SUBSCRIPTIONS=all of them, SUBSCRIPTIONS_<tid>=just one tenant's) and
  # prove the caller filters. With no such key, fall back to SUBSCRIPTIONS.
  "account list"*)
    _q_tenant="$(printf '%s' "$*" | sed -n "s/.*tenantId=='\([^']*\)'.*/\1/p")"
    if [ -n "$_q_tenant" ] && grep -q "^SUBSCRIPTIONS_${_q_tenant}=" "$AZ_STATE" 2>/dev/null; then
      echo "$(state "SUBSCRIPTIONS_${_q_tenant}")" | tr ',' '\n'
    else
      echo "$(state SUBSCRIPTIONS)" | tr ',' '\n'
    fi
    ;;
  "cloud show"*"resourceManager"*)   echo "$(state ARM_ENDPOINT)" ;;
  "cloud show"*"microsoftGraphResourceId"*) echo "$(state GRAPH_ENDPOINT)" ;;
  "cloud show"*"storageEndpoint"*)   echo "$(state BLOB_SUFFIX)" ;;
  "cloud show"*"activeDirectory"*)   echo "$(state AD_ENDPOINT)" ;;
  "group show"*)                     [ "$(state RG_EXISTS)" = 1 ] || exit 1 ;;
  "storage account show"*"--query id"*) echo "/subscriptions/s/rg/r/sa" ;;
  "storage account show"*"primaryEndpoints.blob"*) echo "$(state BLOB_ENDPOINT)" ;;
  "storage account show"*)           [ "$(state SA_EXISTS)" = 1 ] || exit 1 ;;
  "ad app list"*)                    echo "$(state APP_ID)" ;;
  "ad app create"*)                  echo "new-app-id" ;;
  "ad sp list"*)                     echo "$(state SP_OID)" ;;
  "ad sp create"*)                   echo "new-sp-oid" ;;
  "ad app credential reset"*)        echo '{"password":"stub-secret"}' ;;
  "ad sp show --id 00000003"*)       echo '{"appRoles":[{"value":"User.Read.All","id":"r1"},{"value":"Group.Read.All","id":"r2"}],"oauth2PermissionScopes":[{"value":"User.Read","id":"s1"},{"value":"Directory.Read.All","id":"s2"}]}' ;;
  "rest "*)                          echo '{"id":"/exports/stub"}' ;;
  *) : ;;
esac
exit 0
